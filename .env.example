# AXIS Prospector API - Variables de Entorno
# ============================================
# Copia este archivo a .env y completa con tus credenciales

# Apify - Google Maps Scraper
# Obtén tu token en: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Supabase - Base de Datos
# Obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_PASSWORD=

# App Config
DEBUG=false
LOG_LEVEL=INFO

# Client Config (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
