# AXIS Prospector - Variables de Entorno
# =======================================
# Copia este archivo a .env y completa con tus credenciales
#
# ESTRUCTURA:
# - Este archivo (.env en raíz) → Variables del SERVER (Python/FastAPI)
# - client/.env.local → Variables del CLIENT (Next.js con NEXT_PUBLIC_*)
#
# ⚠️  NUNCA subir .env o .env.local a Git

# ============================================
# SERVER (Python/FastAPI)
# ============================================

# Apify - Google Maps Scraper
# Obtén tu token en: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Supabase - Base de Datos (usa SERVICE ROLE KEY para el server)
# Obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_PASSWORD=

# App Config
DEBUG=false
LOG_LEVEL=INFO
