# Client Environment Variables (Next.js)
# =======================================
# Copia este archivo a .env.local y completa los valores
#
# NOTA: Solo variables con prefijo NEXT_PUBLIC_* están disponibles en el browser
# Las variables sin prefijo solo están disponibles en el servidor Next.js

# API URL del backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase - Solo ANON KEY para el cliente (NO usar service_role key)
# La anon key es segura para exponer en el browser (tiene RLS habilitado)
# Obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
